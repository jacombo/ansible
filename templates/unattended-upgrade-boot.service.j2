# Ansible managed
[Unit]
Description=Run unattended-upgrades immediately after boot
After=network-online.target apt-daily.service apt-daily-upgrade.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -w 300 /var/lib/dpkg/lock-frontend /usr/bin/unattended-upgrade -d -v
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
